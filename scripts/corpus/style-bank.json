    "style_pattern": "style"
  },
  {
    "kind": "hesitation",
    "pattern": "Well, and you want your fortune told?",
    "source_book": "1260",
    "style_pattern": "style"
  },
  {
    "kind": "hesitation",
    "pattern": "And I must cross it with silver, I suppose?",
    "source_book": "1260",
    "style_pattern": "style"
  },
  {
    "kind": "hesitation",
    "pattern": "I believe you,",
    "source_book": "1260",
    "style_pattern": "style"
  },
  {
    "kind": "hesitation",
    "pattern": "You know—and perhaps think well of.",
    "source_book": "1260",
    "style_pattern": "style"
  },
  {
    "kind": "hesitation",
    "pattern": "What the devil have you seen, then?",
    "source_book": "1260",
    "style_pattern": "style"
  },
  {
    "kind": "hesitation",
    "pattern": "Well, Jane, do you know me?",
    "source_book": "1260",
    "style_pattern": "style"
  },
  {
    "kind": "hesitation",
    "pattern": "Well, Jane?",
    "source_book": "1260",
    "style_pattern": "style"
  },
  {
    "kind": "hesitation",
    "pattern": "I suppose so, sir.",
    "source_book": "1260",
    "style_pattern": "style"
  },
  {
    "kind": "hesitation",
    "pattern": "They say, Farewell, or any other form they prefer.",
