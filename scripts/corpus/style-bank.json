  },
  {
    "kind": "hesitation",
    "pattern": "With my mother upstairs. She will be down in a moment, I dare say.",
    "source_book": "1342",
    "style_pattern": "style"
  },
  {
    "kind": "hesitation",
    "pattern": "And _that_, I suppose, is one of your sisters?",
