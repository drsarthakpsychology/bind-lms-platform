    "style_pattern": "style"
  },
  {
    "kind": "topic_shift",
    "pattern": "I am talking of possibilities, Charles.",
    "source_book": "1342",
    "style_pattern": "style"
  },
  {
    "kind": "topic_shift",
    "pattern": "I must think your language too strong in speaking of both,",
