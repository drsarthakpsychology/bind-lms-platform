# ============================================================
# PLMS environment variables — single source of truth
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ============================================================

# Canonical origin of the deployed app (scheme + host, no trailing slash).
# Used as the same-origin gate on media-token endpoints. On Vercel this
# should be your production domain, e.g. https://bind-lms-platform.vercel.app
NEXT_PUBLIC_APP_URL=

# Strong, independent secret used to sign stream-session tokens and derive
# per-session media keys. MUST be set in production. If unset, the Supabase
# service-role key is used as the fallback (never a public key).
# Generate: openssl rand -base64 32
SESSION_SECRET=

# --- Supabase (database + auth + current video/submission storage) ---
# Where to get each: https://supabase.com -> your project -> Settings -> API

# The project's internet address (Project URL).
NEXT_PUBLIC_SUPABASE_URL=

# Public/anon key — safe to expose to the browser. Labeled "anon public" or
# "publishable" in the dashboard. Used by the client + server + proxy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only admin key that bypasses RLS. NEVER prefix with NEXT_PUBLIC_.
# Used only by admin server actions. Labeled "service_role secret".
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (video delivery — Cloudflare R2 + self-encoded HLS) ---
# DECISION MADE: Cohort One videos will move to Cloudflare R2 with HLS.
# These are NOT yet read by the app (video still streams from Supabase
# Storage today). They are the seam for the R2 migration.
# Where to get each: https://dash.cloudflare.com -> your account -> R2.

# Your Cloudflare account ID (dashboard -> right sidebar -> Account ID).
CLOUDFLARE_ACCOUNT_ID=

# An R2 API token with read access to the videos bucket.
# Create at: R2 -> Manage R2 API Tokens.
R2_ACCESS_KEY_ID=

# The secret half of the same token (shown once at creation).
R2_SECRET_ACCESS_KEY=

# The bucket name holding lesson videos (e.g. "plms-videos").
R2_BUCKET_NAME=

# Public base URL for the bucket (R2 -> bucket -> Settings -> "Public
# URL" / custom domain). Used to build the HLS .m3u8 URL in a Worker.
# OPTIONAL until HLS playback ships.
R2_PUBLIC_URL=

# R2 BACKUPS bucket (nightly DB dumps + weekly verification). Separate bucket
# from media. Used by .github/workflows/backup.yml and verify-backup.yml.
# Create it in R2 and store the name here + as a GitHub secret.
R2_BACKUP_BUCKET=

# --- Error monitoring (Sentry) — OPTIONAL but recommended ---
# Where: https://sentry.io -> create project "plms" -> DSN.
# Both vars point at the same DSN; the NEXT_PUBLIC_ one is used in the
# browser, the server one in Node. If unset, Sentry is silently disabled.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# --- Product analytics (PostHog) — OPTIONAL ---
# Where: https://eu.posthog.com -> create project -> API key (project API key).
# The key is public (browser-sent); leave unset to keep analytics inert.
# EU cloud by default (GDPR, no model training). Self-hosted instances can be
# pointed at via NEXT_PUBLIC_POSTHOG_HOST.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Cloudflare Turnstile (login bot protection) — OPTIONAL ---
# Where: https://dash.cloudflare.com -> Turnstile -> create widget.
# NEXT_PUBLIC_ site key is public; the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- GitHub Actions secrets (NOT used by the app) ---
# These are set in GitHub -> Settings -> Secrets, not .env.local:
#   SUPABASE_DB_URL, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
#   R2_BACKUP_BUCKET, RESEND_API_KEY, ALERT_EMAIL, SITE_URL

# --- Cohort-pulse nudge (admin) — OPTIONAL. Without these the /admin/pulse
#     nudge honestly reports "email-not-configured" and sends nothing. ---
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL="VIBHA School of Psychology <noreply@vibhaschoolofpsychology.in>"

# --- Voice synthesis (free-first; see docs/MODEL_RESEARCH.md) ---
# MiMo-V2.5-TTS (MIT, arena-top) — OpenAI-compatible /v1/audio/speech at
# MIMO_TTS_URL (Xiaomi API free beta, or self-host). First tier tried.
# MIMO_TTS_URL=
# MIMO_TTS_API_KEY=
# Kokoro-82M (Apache 2.0, CPU) — the zero-cost tier that runs today on the
# Mac. URL of a self-hosted OpenAI-compatible audio/speech endpoint.
# KOKORO_API_URL=
# Qwen3-TTS — hosted (SiliconFlow) or self-host OpenAI-compatible endpoint.
# QWEN_TTS_URL=
# QWEN_TTS_API_KEY=
# Chatterbox (MIT, native affect tags) — self-host OpenAI-compatible endpoint.
# CHATTERBOX_TTS_URL=
# CHATTERBOX_TTS_API_KEY=
# CosyVoice 2 (Apache 2.0) + Whisper STT via NVIDIA NIM (free, no card).
NVIDIA_API_KEY=              # build.nvidia.com — free, no card. CosyVoice 2 + Whisper STT.

# --- ElevenLabs premium TTS (LAST-RESORT, paid, NOT recommended) — only tried
#     after every free tier fails. Only if you specifically want premium voices.
# ELEVENLABS_API_KEY=sk_xxx
# ELEVENLABS_VOICE_ID=xxx

# --- AI Model Router (practice layer) — all OPTIONAL, no card needed ---
# Free tiers are rate-limited, not rate-free; the router stacks them and fails
# over on 429. AI_ENABLED=false → deterministic fixtures, app fully works.
GEMINI_API_KEY=          # aistudio.google.com — free, no card. Best quality + 1M ctx.
GROQ_API_KEY=            # console.groq.com — free, no card. PRIMARY Director/Actor lane (no-train, fast, JSON).
CEREBRAS_API_KEY=        # cloud.cerebras.ai — free, no card. Bulk corpus processing.
SAMBANOVA_API_KEY=       # cloud.sambanova.ai — free, no card, no-train. Cerebras
                         # alternative for the student-facing fallback lane (Llama-3.3-70B).
OPENROUTER_API_KEY=      # openrouter.ai — free, no card. Overflow lane.
OPENCODE_API_KEY=        # opencode.ai/zen — OpenAI-compatible gateway (OpenAI/Anthropic/Qwen
                         # via one key). Secondary no-train student lane.
OMNIROUTE_URL=           # OmniRoute gateway. Default http://localhost:20128/v1 (local).
                         # In production set to the cloud instance, e.g.
                         # https://omniroute.fly.dev/v1 (always-on, runs when the laptop is closed).
OMNIROUTE_API_KEY=       # optional key for the OmniRoute gateway if it requires one.
                         # PRIVACY: for student data, configure OmniRoute with only no-train
                         # upstreams (the gateway itself does not train).
ANTHROPIC_API_KEY=       # optional, PAID — used for student-facing calls when present.
DEEPSEEK_API_KEY=        # api.deepseek.com — PAID, V4 Flash/Pro. Bulk NON-student work only
                         # (trainsOnData posture unresolved → guard keeps it off student data).
AI_ENABLED=              # "false" → deterministic fixtures, whole app still works
AI_DEBUG=                # "true" → log every AI call to the server console
AI_FIXTURE_FALLBACK=     # "true" → fall back to fixtures when no provider (dev only)
AI_STUDENT_TIER=         # "no_train_only" (default, strict) | "any" (DEV ONLY override) — see docs/AI_ARCHITECTURE.md
CRON_SECRET=            # bearer token for GitHub Actions cron endpoints (keep private)
APP_URL=                # https://your-app.vercel.app — used by cron workflows

# --- Corpus fetchers (v5 §5.2) — optional ---
# WHO ICD-11 API programmatic tier (public browser tier works without these).
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=
