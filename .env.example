# Supabase project settings — find these in Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The public/anon key. Safe to expose to the browser as long as RLS is on
# for every table (Part 4 assumes this — do not skip the RLS section of
# schema.sql). Some newer Supabase projects label this the "publishable
# key" (starts with sb_publishable_...) instead of "anon key" — either
# works the same way here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role key — SERVER-ONLY, never prefix with NEXT_PUBLIC_.
# Bypasses Row Level Security entirely. Used by the Admin API flow
# (Phase 3: creating students directly, no public sign-up) and nowhere
# in client-facing code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
