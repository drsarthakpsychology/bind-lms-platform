# VIBHA School of Psychology LMS: environment variable template.
# Copy to .env.local and fill in values. Never commit .env.local.
# Every name the code reads is listed here with an empty value.
# What each one does, and where it is set on Vercel: docs/ENVIRONMENT_VARIABLES.md

# ---- Core (required) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public site address, for example https://vibhapsychology.com (no trailing slash)
NEXT_PUBLIC_APP_URL=
# Optional base for certificate links. Falls back to NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SITE_URL=
# Signs video stream tokens. Make one with: openssl rand -base64 32
SESSION_SECRET=
# Bearer token for cron endpoints. Same value as the GitHub secret CRON_SECRET.
CRON_SECRET=
# Signs game tokens. Make one with: openssl rand -base64 32
GAMES_SECRET=

# ---- Cloudflare R2 (lecture video, credentials, voice cache) ----
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Old upload switch: supabase or r2. Playback ignores it.
NEXT_PUBLIC_MEDIA_PROVIDER=

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=
RESEND_DAILY_LIMIT=
# Preview builds email only these addresses (comma separated)
ALLOWED_TEST_RECIPIENT=
# Set to 0 to turn a reminder type off
REMINDERS_SESSION_TOMORROW=
REMINDERS_ASSIGNMENT_DUE_48H=
REMINDERS_INACTIVE_7D=

# ---- AI (all optional; AI_ENABLED=false uses fixtures) ----
AI_ENABLED=
AI_DEBUG=
AI_FIXTURE_FALLBACK=
AI_STUDENT_TIER=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
OMNIROUTE_URL=
OMNIROUTE_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# ---- Voice (all optional) ----
NVIDIA_API_KEY=
DEEPGRAM_API_KEY=
MIMO_TTS_URL=
MIMO_TTS_API_KEY=
KOKORO_API_URL=
QWEN_TTS_URL=
QWEN_TTS_API_KEY=
CHATTERBOX_TTS_URL=
CHATTERBOX_TTS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# livekit-agent worker only
LIVEKIT_TTS_MODEL=
LIVEKIT_TTS_VOICE=
LIVEKIT_STT_MODEL=

# ---- Monitoring, analytics, bot check (all optional) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- App switches ----
# production = students see only published medicine pages
NEXT_PUBLIC_PSYCH_MODE=

# ---- Scripts only (never needed on Vercel) ----
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=
R2_ACCOUNT_ID=
R2_BACKUP_BUCKET=
R2_NEW_ACCESS_KEY_ID=
R2_NEW_SECRET_ACCESS_KEY=
SITE_URL=
APP_URL=
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=
PMC_CASE_LIMIT=
ACQUIRE_DROP_FOLDER=
SIM_ENV_FILE=
SIM_EVAL_LIVE=

# ---- End-to-end tests (Playwright) ----
E2E_BASE_URL=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_LESSON_URL=
E2E_ASSIGNMENT_URL=
