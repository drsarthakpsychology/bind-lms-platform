{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "NotebookEdit",
      "TodoWrite",
      "Agent",
      "Bash",
      "WebSearch",
      "WebFetch"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(supabase db push *)",
      "Bash(npx supabase db push *)",
      "Bash(psql *)",
      "Bash(eas build *)",
      "Bash(npx eas build *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(scripts/roster/*.csv)",
      "Bash(next build *)",
      "Bash(npx next build *)",
      "Bash(npm run build *)"
    ]
  },
  "enabledPlugins": {
    "42crunch-api-security-testing@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "data-engineering@claude-plugins-official": true
  }
}
